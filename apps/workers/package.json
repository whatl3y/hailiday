{
  "name": "@hailiday/workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --clear-screen=false --import @hailiday/server/config/load-env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hailiday/core": "workspace:*",
    "@hailiday/server": "workspace:*",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
