{
  "name": "@hailiday/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --clear-screen=false --import @hailiday/server/config/load-env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.10",
    "@hailiday/core": "workspace:*",
    "@hailiday/server": "workspace:*",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
