# Hailiday configuration: copy this file to .env (`cp .env.example .env`) and edit it there.
#
# One file drives everything. `docker compose up --build` loads .env into the migrate, api
# and workers containers, and `pnpm dev` (and `pnpm db:migrate` / `pnpm db:seed`) on the
# host reads the same file. The values below are for host development (localhost URLs);
# inside Docker, Compose overrides the in-network endpoints automatically (DATABASE_URL,
# S3_ENDPOINT, SMTP_URL, PORT and EMAIL_PROVIDER=smtp), so you never edit them for Docker.
# Without a .env everything still runs on the defaults. Never commit .env.
#
# Which value wins:
#   - Host (`pnpm dev`, `pnpm db:migrate`, `pnpm db:seed`): a variable already set in your shell
#     wins over this file, EXCEPT the provider keys GOOGLE_MAPS_SERVER_KEY,
#     GOOGLE_STREET_VIEW_BROWSER_KEY, GOOGLE_STREET_VIEW_SIGNING_SECRET, OPENAI_API_KEY,
#     GEMINI_API_KEY and ANTHROPIC_API_KEY. Those come only from this file: a copy exported in
#     your shell is dropped at startup (the process names what it ignored), so a key exported for
#     another project can never start paid calls here.
#   - Docker (`docker compose up`): the migrate, api and workers containers read this file, and
#     your shell's variables are not passed into them, so provider keys again come only from
#     here. Compose itself sets the in-network endpoints listed above. Only the values Compose
#     interpolates into its own file (PUBLIC_BASE_URL, S3_PUBLIC_ENDPOINT, the storage service's
#     credentials and the published *_PORT values) take a shell value over this file, as Compose
#     always does. `pnpm docker:e2e` blanks every provider key and forces fixture mode.
#   - Never set ANTHROPIC_BASE_URL, ANTHROPIC_AUTH_TOKEN or ANTHROPIC_CUSTOM_HEADERS for Hailiday.
#     The Anthropic SDK would otherwise send the vision key and customer images wherever they
#     point, so the host loader removes them from your shell and ignores them here, and the app
#     refuses to start when one reaches it (for example through Docker or a host config var).
#
# Leaving the provider keys empty keeps every integration in fixture mode (no paid calls).
# Adding OPENAI_API_KEY (or GEMINI_API_KEY) plus ANTHROPIC_API_KEY switches decorations to the
# live photorealistic models: uploads are analyzed by Claude and decorated by the image model.
# Street View AI stays off until the licensing grant is recorded, so with Google keys the address
# path shows real Street View for confirmation and then asks for the visitor's own photo.
#
# Leave a value empty or commented out to use its default. Tests never read this file.

# ---- Core -------------------------------------------------------------------------------------
# Environment: development, test, staging or production (local defaults apply only to the first two).
APP_ENV=development
# Log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# HTTP port of the API on the host (it also serves the web app); Docker always uses 8080 inside.
PORT=8080
# Absolute base URL for magic links, share pages and Open Graph tags (match APP_PORT in Docker).
PUBLIC_BASE_URL=http://localhost:8080
# Postgres connection string (the compose Postgres is published on DB_PORT).
DATABASE_URL=postgres://postgres:postgres@localhost:5434/hailiday
# Database the test suites recreate (set it in your shell for `pnpm test`; tests never load .env).
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5434/hailiday_test
# Connection pool size per process.
DATABASE_POOL_MAX=10
# HMAC secret for sessions and signed tokens; at least 32 characters, never the default outside development.
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
# Comma-separated emails that get the operator role at sign-in.
OPERATOR_EMAILS=
# Magic link lifetime in minutes.
MAGIC_LINK_TTL_MIN=15
# Minutes an operator re-authentication stays fresh.
OPERATOR_REAUTH_MIN=15
# Cache lifetime in seconds for runtime settings and capabilities.
SETTINGS_CACHE_S=30
# Release identifier reported in logs.
APP_VERSION=0.1.0
# Error reporting DSN (empty disables it).
SENTRY_DSN=
# Proxies in front of the API whose X-Forwarded-For entry is trusted (default 0 locally, 1 elsewhere).
# TRUST_PROXY_HOPS=0

# ---- Storage (S3-compatible; compose runs RustFS) -----------------------------------------------
# Endpoint the server uses.
S3_ENDPOINT=http://localhost:9000
# Endpoint presigned URLs are signed for (what the browser can reach; match STORAGE_PORT).
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Region name sent to the S3 API.
S3_REGION=us-east-1
# Access key and secret (compose's RustFS is created with the same values).
S3_ACCESS_KEY_ID=hailiday
S3_SECRET_ACCESS_KEY=hailiday-dev-secret
# Private bucket (originals, renders) and public bucket (heroes, examples, share cards).
S3_PRIVATE_BUCKET=hailiday-private
S3_PUBLIC_BUCKET=hailiday-public
# Path-style bucket addressing (true for RustFS and MinIO).
S3_FORCE_PATH_STYLE=true
# Base URL of public assets (defaults to S3_PUBLIC_ENDPOINT/S3_PUBLIC_BUCKET).
PUBLIC_ASSET_BASE_URL=
# Comma-separated origins allowed by bucket CORS (default PUBLIC_BASE_URL; development and test
# also allow the Vite dev server, http://localhost:5173).
STORAGE_CORS_ORIGINS=
# Lifetime of presigned downloads in seconds (at most 900).
SIGNED_URL_TTL_S=900
# Lifetime of presigned upload forms in seconds (at most 300).
UPLOAD_POLICY_TTL_S=300
# Largest accepted upload in bytes.
UPLOAD_MAX_BYTES=26214400

# ---- Email -------------------------------------------------------------------------------------
# Host default: fixture (the magic link is written to the API log). Docker always uses smtp,
# delivered to Mailpit at http://localhost:8025. Staging and production must set smtp: they refuse
# to start with the fixture sender.
# EMAIL_PROVIDER=fixture
# SMTP transport used when EMAIL_PROVIDER=smtp (Mailpit's SMTP port is not published to the host).
SMTP_URL=smtp://localhost:1025
# Sender of magic links and notices.
EMAIL_FROM="Hailiday <hello@hailiday.local>"

# ---- Providers and keys -------------------------------------------------------------------------
# auto uses the live provider when its key is set and the fixture otherwise (auto is the default
# only in development; test, staging and production default to fixture).
# Address lookup: auto, fixture or google (google needs GOOGLE_MAPS_SERVER_KEY).
ADDRESS_PROVIDER=auto
# Street View: auto, fixture or google (google also needs the browser key and signing secret).
STREET_VIEW_PROVIDER=auto
# Image editing: auto, fixture, openai or gemini (auto picks IMAGE_EDITOR_PREFERENCE when both keys are set).
IMAGE_EDITOR_PROVIDER=auto
# Live editor auto picks when both OPENAI_API_KEY and GEMINI_API_KEY are set: openai or gemini
# (default openai: gpt-image-2.5-flare at medium quality had the most judge-accepted variants at
# the lowest cost per accepted variant in the bake-off). With only GEMINI_API_KEY set, auto uses
# Gemini (gemini-nano-banana-2.1, 1K, minimal thinking); set gemini here to prefer it.
IMAGE_EDITOR_PREFERENCE=openai
# Send the composite mask to the image editor: none or tight (default none; paste-back always uses it).
IMAGE_EDIT_PROVIDER_MASK=none
# Scene analysis and judging: auto, fixture or anthropic.
VISION_PROVIDER=auto
# Upload screening: fixture (live vendors are not chosen yet).
SAFETY_PROVIDER=fixture
# Shop the look retailers: fixture (example programs) or real (actual retailers, never in tests); auto, the development default, serves real.
# COMMERCE_PROGRAMS=auto
# Bot check: fixture (accepts the public token fixture-pass; development and test only) or live.
# Staging and production must set live with both Turnstile keys: they refuse to start otherwise.
TURNSTILE_MODE=fixture
# Google Maps Platform server key (Places, Geocoding, Street View metadata).
GOOGLE_MAPS_SERVER_KEY=
# Google browser key for signed Street View Static images.
GOOGLE_STREET_VIEW_BROWSER_KEY=
# URL signing secret for Street View Static images.
GOOGLE_STREET_VIEW_SIGNING_SECRET=
# Embedded attribution rectangles of live Street View Static frames, measured on real frames and
# recorded per requested size: JSON mapping "<width>x<height>" to a list of [x0, y0, x1, y1] boxes
# normalized to that frame. Default: the Google logo and copyright box measured on live 640x640
# frames, {"640x640":[[0,0.955,0.11,1],[0.8,0.965,1,1]]}; {} configures none; invalid JSON stops
# startup.
# STREET_VIEW_ATTRIBUTION_REGIONS=
# What new Street View policies allow for Google-attributed imagery: full (default; decorated,
# stored privately, downloadable and shareable with attribution, Shop the look shown), decorate
# (decorated in memory only; private previews with no download or share) or display_only (shown
# for confirmation only; the visitor uploads a photo to decorate).
STREET_VIEW_USE_POLICY=full
# Street View imagery credited to someone other than Google: decorate (default; treated exactly as
# STREET_VIEW_USE_POLICY treats Google's) or display_only (shown for confirmation only, any policy).
STREET_VIEW_CONTRIBUTOR_IMAGERY=decorate
# Days after which a stored Street View frame is fetched again before it is decorated (default 30;
# one $0.007 Static fetch, plus a scene analysis when the bytes differ). The fetched frame replaces
# the stored copy (unless a preservation hold covers the source) and the render goes on with it,
# so no new look is made from the old copy; other bytes never take the address out of use.
STREET_VIEW_FRAME_MAX_AGE_DAYS=30
# Whether a stored Street View frame is first redrawn sharper and cleaner by the image editor (and
# checked by the vision model) before it is decorated: on (default) or off. off decorates Google's
# frame as it is. It needs the stored frame (STREET_VIEW_USE_POLICY=full); about $0.06 once per
# address and release, about 30 s more on an address's first look. Whatever goes wrong, the look
# goes on with Google's frame.
STREET_VIEW_ENHANCE=on
# Whether a Street View address's frame is zoomed in on the home at its first look: on (default)
# or off. The vision model boxes the home in the fetched frame and the frame is fetched again from
# the same panorama at the view that fills the picture with it (about $0.02 and one $0.007 Static
# fetch once per address, a few seconds on the first look). off keeps the candidate's wider view.
# An address that already has looks keeps its frame; whatever goes wrong, the look goes on with
# the frame it fetched.
STREET_VIEW_FRAMING=on
# OpenAI key for photorealistic image edits.
# Before you add it (docs/development.md#live-mode, "Before you add a key"): an organization with zero data retention enabled for the image endpoints.
OPENAI_API_KEY=
# OpenAI image model snapshot (default gpt-image-2.5-flare).
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# OpenAI image quality: low, medium, high or auto (default medium).
OPENAI_IMAGE_QUALITY=medium
# Google Gemini key for image edits.
# Before you add it (docs/development.md#live-mode, "Before you add a key"): a key from a Google AI Studio or Google Cloud project with billing enabled (the paid tier).
GEMINI_API_KEY=
# Gemini image model (default gemini-nano-banana-2.1).
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Gemini output size: 1K or 2K (default 1K).
GEMINI_IMAGE_SIZE=1K
# Gemini thinking level: minimal, medium or high (default minimal).
GEMINI_THINKING_LEVEL=minimal
# Anthropic key for scene analysis and quality judging.
ANTHROPIC_API_KEY=
# Claude model used for vision.
ANTHROPIC_VISION_MODEL=claude-opus-5-5
# Cloudflare Turnstile keys for TURNSTILE_MODE=live.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Limits and queue ---------------------------------------------------------------------------
# Render worker heartbeat in seconds (at least 10).
RENDER_HEARTBEAT_S=15
# Longest a render job may run, in seconds: at least 240, and a lower value is raised to 240 (a relit
# look may use three edit attempts; the queue expiry follows it).
RENDER_MAX_JOB_DURATION_S=240
# Time a repair attempt needs left on the job, in seconds.
RENDER_REPAIR_BUDGET_S=48
# Transport retries per render attempt.
RENDER_TRANSPORT_RETRY_LIMIT=2
# Base and maximum retry backoff in seconds.
RENDER_RETRY_DELAY_S=2
RENDER_RETRY_DELAY_MAX_S=10
# Render jobs one worker runs at once.
RENDER_WORKER_CONCURRENCY=2
# Longest upload validation and screening jobs, in seconds.
UPLOAD_VALIDATE_MAX_DURATION_S=60
UPLOAD_SCREEN_MAX_DURATION_S=120
# Admission control: queued renders allowed and the longest expected wait in seconds.
RENDER_QUEUE_DEPTH_MAX=36
RENDER_MAX_WAIT_S=240
# Per-provider concurrency, as <PROVIDER>_MAX_CONCURRENCY (for example OPENAI_MAX_CONCURRENCY=4).
# OPENAI_MAX_CONCURRENCY=
# Runtime setting overrides: the setting key upper-cased with dots as underscores, value as JSON
# (prefixes ALLOWANCE_, QUOTA_, RATE_, SPEND_, ADMISSION_, PAUSE_, DISCOVERY_, REVIEW_,
# IDEMPOTENCY_, SSE_, POLL_, RETENTION_), for example ALLOWANCE_VARIANTS_PER_24H=5.
# With APP_ENV=development and no value set, the six limits below default to generous values for
# local testing; staging, production and test use the specified values. A value set here always wins.
# Accepted variants per owner per 24 h (default 30 in development, otherwise 3).
# ALLOWANCE_VARIANTS_PER_24H=
# New addresses per owner per 24 h (default 30 in development, otherwise 3).
# ALLOWANCE_ADDRESSES_PER_24H=
# Paid render attempts per owner per 24 h (default 60 in development, otherwise 8).
# QUOTA_ATTEMPTS_PER_OWNER_24H=
# Render requests per device per 24 h (default 300 in development, otherwise 6).
# QUOTA_RENDER_REQUESTS_PER_DEVICE_24H=
# Render requests per IP address per 24 h (default 300 in development, otherwise 6).
# QUOTA_RENDER_REQUESTS_PER_IP_24H=
# New anonymous sessions per IP per 10 minutes (default 200 in development, otherwise 20).
# RATE_SESSIONS_PER_IP_10M=
# Time-based deletion of projects, photos and looks by age or inactivity (default false: kept).
# Turning it on deletes at once every unsaved project idle over 24 hours or older than 7 days
# (with its photos and looks) and ends kept sessions older than 7 days.
# RETENTION_TIME_BASED_DELETION=

# ---- Docker Compose ports (published on the host; read by Compose only) -------------------------
# The app (keep PUBLIC_BASE_URL in step).
APP_PORT=8080
# Postgres (keep DATABASE_URL in step).
DB_PORT=5434
# Storage API (keep S3_PUBLIC_ENDPOINT in step) and the storage console.
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
# Mailpit inbox (http://localhost:8025).
MAILPIT_PORT=8025

# ---- Browser tests and the web dev server (read from your shell, not from this file) ------------
# Base URL Playwright tests against (default http://localhost:8080; `pnpm docker:e2e` starts it).
# HAILIDAY_E2E_BASE_URL=http://localhost:8080
# Mailpit API the e2e suite reads magic links from.
# HAILIDAY_E2E_MAILPIT_URL=http://localhost:8025/api/v1
# API the Vite dev server (`pnpm web:dev`) proxies to.
# HAILIDAY_API_URL=http://localhost:8080
